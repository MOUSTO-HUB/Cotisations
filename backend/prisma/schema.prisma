// Modèle de données — cahier des charges, section 8.
// Règles : montants en BigInt (unités de la devise, sans centimes),
// dates en UTC, écritures financières jamais supprimées (contre-écriture).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Énumérations ----------

enum GroupType {
  FAMILY
  COMMUNITY
  TONTINE
}

enum Currency {
  GNF
  XOF
  XAF
  EUR
  USD
}

enum Role {
  PRESIDENT
  TREASURER
  SECRETARY
  AUDITOR
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum Periodicity {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM_DAYS
}

enum DueStatus {
  PENDING
  PAID
  PARTIAL
  LATE
  EXEMPT
}

enum PaymentChannel {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING_CONFIRMATION // espèces saisies par le trésorier (RG-C1)
  CONFIRMED
  DISPUTED // contesté par le membre, à régler par le bureau
  FAILED
  REVERSED // annulé par contre-écriture (RG-C4)
}

enum MovementDirection {
  IN
  OUT
}

enum CashboxKind {
  GENERAL
  SOLIDARITY
  PROJECT
  TONTINE
}

enum SwapStatus {
  REQUESTED // demandé par le bénéficiaire d'un tour
  ACCEPTED // accepté par le bénéficiaire de l'autre tour
  APPROVED // validé par le président : les tours sont échangés
  REJECTED
  CANCELLED
}

enum BeneficiaryOrderMode {
  FIXED
  DRAW
  AUCTION
}

enum TontineCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RoundStatus {
  UPCOMING
  COLLECTING
  COMPLETE
  PAID_OUT
}

enum ProjectStatus {
  PROPOSED
  BUDGETED
  VOTED
  COLLECTING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING_APPROVAL // au-delà du seuil, attend un second validateur (RG-D1)
  EXECUTED
  REJECTED
  REVERSED
}

enum SolidarityReason {
  HEALTH // raison de santé — jamais de diagnostic
  DEATH
  DISASTER // sinistre : incendie, inondation…
  OTHER
}

enum DonationStatus {
  RECORDED
  REVERSED
}

enum CampaignStatus {
  OPEN
  CLOSED
  PAID_OUT
}

// ---------- Utilisateurs et groupes ----------

model User {
  id                String       @id @default(uuid())
  phone             String       @unique // format E.164, ex. +224620000000
  fullName          String
  pinHash           String?
  language          String       @default("fr")
  country           String       @default("GN")
  mobileMoneyNumber String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  memberships       Membership[]
  sessions          Session[]
}

/// Code à usage unique envoyé par SMS. Le code n'est jamais stocké en clair.
model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Session de connexion. Seule l'empreinte SHA-256 du jeton est stockée.
model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  device    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Group {
  id             String               @id @default(uuid())
  type           GroupType
  name           String
  currency       Currency             @default(GNF)
  timezone       String               @default("Africa/Conakry")
  rules          Json                 @default("{}") // seuils, pénalités, délai de grâce…
  archived       Boolean              @default(false)
  /// Dernier numéro de reçu attribué dans ce groupe.
  receiptCounter Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    Membership[]
  cashboxes      Cashbox[]
  plans          ContributionPlan[]
  cycles         TontineCycle[]
  projects       Project[]
  campaigns      SolidarityCampaign[]
  expenses       Expense[]
  donations      Donation[]
  auditLogs      AuditLog[]
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  groupId   String
  role      Role             @default(MEMBER)
  category  String? // résident, diaspora, retraité…
  status    MembershipStatus @default(INVITED)
  joinedAt  DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
  group     Group            @relation(fields: [groupId], references: [id])
  dues      Due[]
  payments  Payment[]
  shares    TontineShare[]
  donations Donation[]

  @@unique([userId, groupId])
}

// ---------- Caisse et écritures ----------

model Cashbox {
  id        String              @id @default(uuid())
  groupId   String
  kind      CashboxKind
  name      String
  group     Group               @relation(fields: [groupId], references: [id])
  movements Movement[]
  plans     ContributionPlan[]
  expenses  Expense[]
  donations Donation[]
  project   Project?
  campaign  SolidarityCampaign?
  tontine   TontineCycle?
}

/// Écriture du journal de caisse. Jamais modifiée ni supprimée :
/// une erreur s'annule par une contre-écriture (reversalOfId).
model Movement {
  id           String            @id @default(uuid())
  cashboxId    String
  direction    MovementDirection
  amount       BigInt
  category     String
  label        String
  authorId     String
  receiptUrl   String?
  paymentId    String?           @unique
  expenseId    String?           @unique
  donationId   String?           @unique
  reversalOfId String?           @unique
  reason       String?
  approvedById String? // second validateur (RG-D1)
  createdAt    DateTime          @default(now())
  cashbox      Cashbox           @relation(fields: [cashboxId], references: [id])
  payment      Payment?          @relation(fields: [paymentId], references: [id])
  expense      Expense?          @relation(fields: [expenseId], references: [id])
  donation     Donation?         @relation(fields: [donationId], references: [id])
  reversalOf   Movement?         @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   Movement?         @relation("Reversal")
}

/// Demande de dépense. L'écriture de caisse (Movement OUT) n'est créée
/// qu'à l'exécution : directement sous le seuil, après validation au-delà.
model Expense {
  id               String        @id @default(uuid())
  groupId          String
  cashboxId        String
  amount           BigInt
  category         String
  label            String
  justificationUrl String? // sans justificatif : « à justifier » (RG-D2)
  budgetLineId     String?
  status           ExpenseStatus
  requestedById    String
  approvedById     String?
  rejectionReason  String?
  reversalReason   String?
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())
  decidedAt        DateTime?
  group            Group         @relation(fields: [groupId], references: [id])
  cashbox          Cashbox       @relation(fields: [cashboxId], references: [id])
  budgetLine       BudgetLine?   @relation(fields: [budgetLineId], references: [id])
  movement         Movement?

  @@index([groupId, createdAt])
}

// ---------- Cotisations ----------

model ContributionPlan {
  id           String              @id @default(uuid())
  groupId      String
  cashboxId    String
  name         String
  amount       BigInt
  periodicity  Periodicity?
  intervalDays Int?
  startDate    DateTime            @db.Date
  endDate      DateTime?           @db.Date
  projectId    String?             @unique
  campaignId   String?             @unique
  createdAt    DateTime            @default(now())
  group        Group               @relation(fields: [groupId], references: [id])
  cashbox      Cashbox             @relation(fields: [cashboxId], references: [id])
  project      Project?            @relation(fields: [projectId], references: [id])
  campaign     SolidarityCampaign? @relation(fields: [campaignId], references: [id])
  dues         Due[]
  payments     Payment[]
}

model Due {
  id           String              @id @default(uuid())
  membershipId String
  planId       String?
  roundId      String?
  amountDue    BigInt
  amountPaid   BigInt              @default(0)
  dueDate      DateTime            @db.Date
  status       DueStatus           @default(PENDING)
  exemptReason String?
  /// Pénalité de retard (RG-P2) : échéance d'origine, une seule pénalité par retard.
  penaltyOfId  String?             @unique
  membership   Membership          @relation(fields: [membershipId], references: [id])
  plan         ContributionPlan?   @relation(fields: [planId], references: [id])
  round        TontineRound?       @relation(fields: [roundId], references: [id])
  allocations  PaymentAllocation[]
  penaltyOf    Due?                @relation("Penalty", fields: [penaltyOfId], references: [id])
  penalty      Due?                @relation("Penalty")

  @@index([membershipId, dueDate])
}

model Payment {
  id                String              @id @default(uuid())
  membershipId      String
  planId            String?
  amount            BigInt
  channel           PaymentChannel
  status            PaymentStatus
  operatorReference String?             @unique
  idempotencyKey    String              @unique
  receiptNumber     String              @unique
  recordedById      String
  createdAt         DateTime            @default(now())
  confirmedAt       DateTime?
  disputeReason     String?
  reversalReason    String?
  membership        Membership          @relation(fields: [membershipId], references: [id])
  plan              ContributionPlan?   @relation(fields: [planId], references: [id])
  movement          Movement?
  allocations       PaymentAllocation[]
}

/// Part d'un paiement imputée à une échéance (RG-C2).
model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  dueId     String
  amount    BigInt
  payment   Payment @relation(fields: [paymentId], references: [id])
  due       Due     @relation(fields: [dueId], references: [id])
}

// ---------- Tontine ----------

model TontineCycle {
  id                 String               @id @default(uuid())
  groupId            String
  cashboxId          String               @unique
  name               String
  createdById        String
  startedAt          DateTime?
  completedAt        DateTime?
  cancelReason       String?
  contributionAmount BigInt
  shareCount         Int
  periodicity        Periodicity
  intervalDays       Int?
  startDate          DateTime             @db.Date
  orderMode          BeneficiaryOrderMode
  status             TontineCycleStatus   @default(DRAFT)
  lockedAt           DateTime? // verrouillage après le premier versement
  drawSeed           Json? // résultat du tirage archivé (RG-T4)
  createdAt          DateTime             @default(now())
  group              Group                @relation(fields: [groupId], references: [id])
  cashbox            Cashbox              @relation(fields: [cashboxId], references: [id])
  shares             TontineShare[]
  rounds             TontineRound[]
  swaps              TontineSwap[]
}

model TontineShare {
  id           String         @id @default(uuid())
  cycleId      String
  membershipId String
  fraction     Int            @default(100) // 100 = part entière, 50 = demi-part
  /// Numéro du tour où cette part reçoit le pot (ordre fixé ou tiré au sort).
  turn         Int?
  cycle        TontineCycle   @relation(fields: [cycleId], references: [id])
  membership   Membership     @relation(fields: [membershipId], references: [id])
  rounds       TontineRound[]
}

model TontineRound {
  id                 String        @id @default(uuid())
  cycleId            String
  number             Int
  dueDate            DateTime      @db.Date
  potAmount          BigInt
  beneficiaryId      String?
  status             RoundStatus   @default(UPCOMING)
  paidOutAt          DateTime?
  paidOutById        String?
  receiptConfirmed   Boolean       @default(false)
  receiptConfirmedAt DateTime?
  cycle              TontineCycle  @relation(fields: [cycleId], references: [id])
  beneficiary        TontineShare? @relation(fields: [beneficiaryId], references: [id])
  dues               Due[]
  swapsAsA           TontineSwap[] @relation("SwapRoundA")
  swapsAsB           TontineSwap[] @relation("SwapRoundB")

  @@unique([cycleId, number])
}

/// Échange de tours entre deux bénéficiaires : accord des deux, puis
/// validation du président (section 4.4).
model TontineSwap {
  id            String       @id @default(uuid())
  cycleId       String
  roundAId      String
  roundBId      String
  status        SwapStatus   @default(REQUESTED)
  requestedById String
  acceptedById  String?
  decidedById   String?
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?
  cycle         TontineCycle @relation(fields: [cycleId], references: [id])
  roundA        TontineRound @relation("SwapRoundA", fields: [roundAId], references: [id])
  roundB        TontineRound @relation("SwapRoundB", fields: [roundBId], references: [id])
}

// ---------- Projets et solidarité ----------

model Project {
  id             String            @id @default(uuid())
  groupId        String
  cashboxId      String            @unique
  title          String
  description    String
  budget         Json              @default("[]") // obsolète : remplacé par BudgetLine
  /// Objectif de collecte = budget − fonds affectés − subventions.
  targetAmount   BigInt            @default(0)
  allocatedFunds BigInt            @default(0) // fonds déjà en caisse affectés au projet
  subsidies      BigInt            @default(0) // subventions ou dons annoncés
  status         ProjectStatus     @default(PROPOSED)
  deadline       DateTime?         @db.Date
  proposedById   String
  approvedById   String?
  approvedAt     DateTime?
  completedAt    DateTime?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  group          Group             @relation(fields: [groupId], references: [id])
  cashbox        Cashbox           @relation(fields: [cashboxId], references: [id])
  budgetLines    BudgetLine[]
  updates        ProjectUpdate[]
  plan           ContributionPlan?
}

/// Poste du budget d'un projet (matériaux, main-d'œuvre, transport, imprévus).
model BudgetLine {
  id            String    @id @default(uuid())
  projectId     String
  position      Int
  label         String
  plannedAmount BigInt
  project       Project   @relation(fields: [projectId], references: [id])
  expenses      Expense[]
}

/// Jalon d'avancement d'un projet, avec photo éventuelle.
model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  authorId  String
  title     String
  note      String?
  photoUrl  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

/// Don libre (membre, ressortissant ou donateur extérieur), avec reçu.
model Donation {
  id             String         @id @default(uuid())
  groupId        String
  cashboxId      String
  membershipId   String?
  donorName      String
  amount         BigInt
  channel        PaymentChannel
  status         DonationStatus @default(RECORDED)
  receiptNumber  String         @unique
  idempotencyKey String         @unique
  recordedById   String
  reversalReason String?
  createdAt      DateTime       @default(now())
  group          Group          @relation(fields: [groupId], references: [id])
  cashbox        Cashbox        @relation(fields: [cashboxId], references: [id])
  membership     Membership?    @relation(fields: [membershipId], references: [id])
  movement       Movement?
}

model SolidarityCampaign {
  id                      String            @id @default(uuid())
  groupId                 String
  cashboxId               String            @unique
  beneficiaryName         String
  reason                  String // motif général uniquement, jamais de diagnostic
  reasonCategory          SolidarityReason  @default(OTHER)
  beneficiaryMembershipId String?
  targetAmount            BigInt
  suggestedAmount         BigInt?
  /// RG-S4 : cotisation obligatoire (échéance pour chaque membre) ou volontaire.
  mandatory               Boolean           @default(false)
  deadline                DateTime          @db.Date
  status                  CampaignStatus    @default(OPEN)
  openedById              String
  closedAt                DateTime?
  createdAt               DateTime          @default(now())
  group                   Group             @relation(fields: [groupId], references: [id])
  cashbox                 Cashbox           @relation(fields: [cashboxId], references: [id])
  plan                    ContributionPlan?
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(uuid())
  groupId   String?
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  device    String?
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id])

  @@index([groupId, createdAt])
}
